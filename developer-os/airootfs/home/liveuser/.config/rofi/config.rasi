/**
 * Spotlight-inspired launcher (light frosted card, centered).
 * Hyprland: layerrule blur on the rofi layer complements semi-transparent rgba.
 * Docs: https://github.com/davatorium/rofi/blob/master/doc/rofi-theme.5.markdown
 */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    terminal:                   "kitty";
    font:                       "DejaVu Sans 14";
    icon-theme:                 "Adwaita";
    display-drun:               "Apps";
    display-run:                "Run";
    drun-display-format:        "{name}";
    /* 0 = center (Spotlight-like placement) */
    location:                   0;
    fixed-num-lines:            false;
}

* {
    /* macOS-ish neutrals */
    spot-bg:                    rgba ( 252, 252, 254, 92 % );
    spot-surface:               rgba ( 255, 255, 255, 96 % );
    spot-fg:                    rgba ( 29, 29, 31, 100 % );
    spot-muted:                 rgba ( 110, 110, 115, 100 % );
    spot-accent:                rgba ( 0, 122, 255, 100 % );
    spot-border:                rgba ( 0, 0, 0, 9 % );
    spot-row-hover:             rgba ( 0, 0, 0, 4 % );
    spot-row-selected:          rgba ( 0, 122, 255, 14 % );

    background-color:           transparent;
    text-color:                 @spot-fg;
    font:                       "DejaVu Sans 14";

    highlight:                  bold underline;

    background:                 @spot-bg;
    foreground:                 @spot-fg;

    normal-background:          transparent;
    normal-foreground:          @spot-fg;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @spot-fg;

    selected-normal-background: @spot-row-selected;
    selected-normal-foreground: @spot-fg;

    active-background:            @spot-row-hover;
    active-foreground:          @spot-accent;
    alternate-active-background: @spot-row-hover;
    alternate-active-foreground: @spot-accent;
    selected-active-background: @spot-row-selected;
    selected-active-foreground: @spot-fg;

    urgent-background:          rgba ( 255, 59, 48, 12 % );
    urgent-foreground:          rgba ( 200, 40, 40, 100 % );
    alternate-urgent-background: @urgent-background;
    alternate-urgent-foreground: @urgent-foreground;
    selected-urgent-background: rgba ( 255, 59, 48, 18 % );
    selected-urgent-foreground: @urgent-foreground;

    border-color:               @spot-border;
    separatorcolor:             transparent;
    scrollbar-handle:           @spot-muted;

    spacing:                    0;
}

window {
    width:                      640px;
    transparency:               "real";
    border-radius:              20px;
    border:                     1px;
    border-color:               @spot-border;
    background-color:           @spot-bg;
    padding:                    20px 20px 16px 20px;
    children:                   [ mainbox ];
}

mainbox {
    spacing:                    14px;
    background-color:           transparent;
    children:                   [ inputbar, message, listview, mode-switcher ];
}

message {
    border:                     0px;
    padding:                    8px 12px;
    border-radius:              10px;
    background-color:           rgba ( 255, 59, 48, 10 % );
    text-color:                 @urgent-foreground;
}

textbox {
    text-color:                 @spot-fg;
}

/* Search field: white inset pill + magnifier (Spotlight-style) */
inputbar {
    spacing:                    0px;
    padding:                    12px 16px;
    border-radius:              12px;
    border:                     1px;
    border-color:               @spot-border;
    background-color:           @spot-surface;
    children:                   [ textbox-prompt-colon, entry, case-indicator ];
}

textbox-prompt-colon {
    expand:                     false;
    str:                        "🔍";
    margin:                     0px 10px 0px 0px;
    text-color:                 @spot-muted;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    font:                       "DejaVu Sans 16";
}

entry {
    placeholder:                "Search";
    placeholder-color:          @spot-muted;
    cursor:                     text;
    padding:                    4px 0px;
    background-color:           transparent;
    text-color:                 @spot-fg;
}

case-indicator {
    spacing:                    0px;
    text-color:                 @spot-muted;
    padding:                    0px 0px 0px 8px;
}

listview {
    lines:                      8;
    cycle:                      true;
    scrollbar:                  false;
    fixed-height:               true;
    spacing:                    4px;
    padding:                    4px 0px 0px 0px;
    border:                     0px;
    background-color:           transparent;
}

element {
    orientation:                horizontal;
    border-radius:              10px;
    padding:                    10px 12px;
    spacing:                    12px;
    border:                     0px;
}

element-icon {
    size:                       36px;
}

element-text {
    background-color:           inherit;
    text-color:                 inherit;
    vertical-align:             0.5;
    highlight:                  #007aff;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @spot-fg;
}

element normal.active,
element alternate.active {
    background-color:           @spot-row-hover;
    text-color:                 @spot-accent;
}

element selected.normal {
    background-color:           @spot-row-selected;
    text-color:                 @spot-fg;
}

element selected.active {
    background-color:           @spot-row-selected;
    text-color:                 @spot-fg;
}

/* Compact mode switcher: segment control */
mode-switcher {
    spacing:                    6px;
    margin:                     4px 0px 0px 0px;
    padding:                    0px;
    border:                     0px;
    background-color:           transparent;
}

button {
    padding:                    8px 14px;
    border-radius:              8px;
    horizontal-align:           0.5;
    vertical-align:             0.5;
    text-color:                 @spot-muted;
    background-color:           transparent;
}

button selected {
    background-color:           @spot-row-selected;
    text-color:                 @spot-fg;
}
