#!/usr/bin/env bash
#
# Developer OS — install to disk (UEFI + GPT, systemd-boot, ext4 root).
# Run from the live session: sudo developer-os-install
#
set -euo pipefail

[[ "$(id -u)" -eq 0 ]] || { echo "Run as root: sudo $0" >&2; exit 1; }

PACMAN_CONF="${PACMAN_CONF:-/etc/pacman.conf}"
PKG_LIST="${PKG_LIST:-/usr/local/share/developer-os/installer-packages.list}"
[[ -f "$PACMAN_CONF" ]] || { echo "Missing $PACMAN_CONF" >&2; exit 1; }
[[ -f "$PKG_LIST" ]] || { echo "Missing $PKG_LIST" >&2; exit 1; }

mapfile -t PKGS < <(sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' "$PKG_LIST")
((${#PKGS[@]})) || { echo "No packages in $PKG_LIST" >&2; exit 1; }

part_suffix() {
  # nvme0n1p1 / mmcblk0p1 vs sda1 / vda1
  if [[ "$1" =~ (nvme|mmcblk) ]]; then
    echo "${1}p${2}"
  else
    echo "${1}${2}"
  fi
}

echo "Developer OS — disk installer"
echo "================================"
echo "UEFI + GPT only. Wipes the entire target disk."
echo
lsblk -dpno NAME,SIZE,MODEL,TRAN | grep -v loop || true
echo
read -r -p "Target disk (e.g. /dev/sda or /dev/nvme0n1): " DISK
[[ -n "${DISK:-}" ]] || exit 1
[[ -b "$DISK" ]] || { echo "Not a block device: $DISK" >&2; exit 1; }

if [[ ! "$DISK" =~ ^/dev/(nvme[0-9]+n[0-9]+|mmcblk[0-9]+|sd[a-z]|vd[a-z])$ ]]; then
  echo "Refusing disk path (use whole disk, e.g. /dev/sda): $DISK" >&2
  exit 1
fi

ESP_PART="$(part_suffix "$DISK" 1)"
ROOT_PART="$(part_suffix "$DISK" 2)"

echo
read -r -p "Login name on installed system [developer]: " IN_USER
IN_USER="${IN_USER:-developer}"
read -r -s -p "Password for ${IN_USER}: " PW1
echo
read -r -s -p "Again: " PW2
echo
[[ -n "$PW1" && "$PW1" == "$PW2" ]] || { echo "Passwords empty or do not match." >&2; exit 1; }

echo
read -r -p "Type YES to wipe ${DISK} and install: " CONF
[[ "$CONF" == "YES" ]] || { echo "Aborted."; exit 1; }

echo "[1/7] Partitioning..."
parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart ESP fat32 1MiB 551MiB
parted -s "$DISK" set 1 esp on
parted -s "$DISK" mkpart root ext4 551MiB 100%
partprobe "$DISK" 2>/dev/null || true
sleep 1
[[ -b "$ESP_PART" && -b "$ROOT_PART" ]] || {
  echo "Partitions not found: $ESP_PART $ROOT_PART" >&2
  exit 1
}

echo "[2/7] Formatting..."
mkfs.fat -F32 -n ESP "$ESP_PART"
mkfs.ext4 -F -L developer_os "$ROOT_PART"

echo "[3/7] Mounting..."
mount "$ROOT_PART" /mnt
mkdir -p /mnt/boot
mount "$ESP_PART" /mnt/boot

echo "[4/7] pacstrap..."
pacstrap -C "$PACMAN_CONF" /mnt "${PKGS[@]}"

echo "[4b/7] MacTahoe KDE theme on target system..."
cp -a /usr/local/bin/install-mactahoe-kde-theme.sh /mnt/usr/local/bin/
chmod 0755 /mnt/usr/local/bin/install-mactahoe-kde-theme.sh
set +e
arch-chroot /mnt /usr/local/bin/install-mactahoe-kde-theme.sh
_mt=$?
set -e
if ((_mt != 0)); then
  echo "[developer-os-install] Theme git install failed (${_mt}); copying from live ISO if present..." >&2
  /usr/local/bin/install-mactahoe-kde-theme.sh --rsync-from-live /mnt || true
fi

echo "[5/7] fstab..."
genfstab -U /mnt >>/mnt/etc/fstab

ROOT_UUID=$(findmnt -no UUID /mnt)
[[ -n "$ROOT_UUID" ]]

echo "[6/7] Bootloader (systemd-boot)..."
install -d /mnt/boot/loader/entries
cat >/mnt/boot/loader/loader.conf <<EOF
default developer-os.conf
timeout 3
console-mode max
editor no
EOF
cat >/mnt/boot/loader/entries/developer-os.conf <<EOF
title   Developer OS
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=${ROOT_UUID} rw quiet
EOF

arch-chroot /mnt env IN_USER="$IN_USER" PW1="$PW1" /bin/bash -s <<'CHROOT'
set -euo pipefail
bootctl install --esp-path=/boot --no-variables
systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable sddm.service
systemctl set-default graphical.target
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true

install -d -m 0750 /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' >/etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel

if ! id -u "${IN_USER}" &>/dev/null; then
  useradd -m -G wheel,video,input,audio,storage -s /usr/bin/zsh "${IN_USER}"
fi
printf '%s\n' "${IN_USER}:${PW1}" | chpasswd

flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
set +e
flatpak install -y --system flathub com.brave.Browser
_brave_fp=$?
set -e
if ((_brave_fp != 0)); then
  echo "[developer-os-install] WARNING: Brave Flatpak install failed (${_brave_fp}); run after boot: flatpak install -y flathub com.brave.Browser" >&2
fi
CHROOT

echo "[7/7] Copy profile helpers from live system..."
install -d /mnt/usr/local/bin /mnt/usr/local/share/developer-os /mnt/usr/local/share/bash-completion/completions /mnt/usr/local/share/zsh/site-functions /mnt/usr/share/applications
[[ -x /usr/local/bin/vfox ]] && cp -a /usr/local/bin/vfox /mnt/usr/local/bin/
[[ -f /usr/local/share/bash-completion/completions/vfox ]] && cp -a /usr/local/share/bash-completion/completions/vfox /mnt/usr/local/share/bash-completion/completions/ || true
[[ -f /usr/local/share/zsh/site-functions/_vfox ]] && cp -a /usr/local/share/zsh/site-functions/_vfox /mnt/usr/local/share/zsh/site-functions/ || true
if [[ -d /opt/jetbrains-toolbox ]]; then
  install -d /mnt/opt
  cp -a /opt/jetbrains-toolbox /mnt/opt/
  ln -sf /opt/jetbrains-toolbox/bin/jetbrains-toolbox /mnt/usr/local/bin/jetbrains-toolbox
  [[ -f /usr/share/applications/jetbrains-toolbox.desktop ]] && cp -a /usr/share/applications/jetbrains-toolbox.desktop /mnt/usr/share/applications/
fi
cp -a /usr/local/bin/developer-os-install /mnt/usr/local/bin/ 2>/dev/null || true
cp -a /usr/local/bin/install-mactahoe-kde-theme.sh /mnt/usr/local/bin/ 2>/dev/null || true
cp -a /usr/local/share/developer-os/installer-packages.list /mnt/usr/local/share/developer-os/

if [[ -d /home/liveuser/.config ]]; then
  install -d "/mnt/home/${IN_USER}"
  rsync -a --exclude='.cache' /home/liveuser/.config/ "/mnt/home/${IN_USER}/.config/"
  for f in .zshrc .zprofile; do
    [[ -f "/home/liveuser/${f}" ]] && cp -a "/home/liveuser/${f}" "/mnt/home/${IN_USER}/${f}" || true
  done
  arch-chroot /mnt chown -R "${IN_USER}:${IN_USER}" "/home/${IN_USER}"
fi

echo
echo "Installed Developer OS on ${ROOT_PART} (EFI ${ESP_PART}). User: ${IN_USER}"
echo "Run: umount -R /mnt && reboot"
echo "Desktop: log in at SDDM (Plasma Wayland is the default session)."
