#!/usr/bin/env bash
# User-facing entry point for updating Developer OS apps (extras + optional pacman).
set -euo pipefail

script="/usr/local/share/developer-os/update-extras.sh"

if [[ ! -x "${script}" ]]; then
  echo "Missing ${script}" >&2
  exit 1
fi

# --check and --help can run without root.
case "${1:-}" in
  --check|-h|--help)
    exec "${script}" "$@"
    ;;
esac

if [[ "$(id -u)" -ne 0 ]]; then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo "${script}" "$@"
  fi
  echo "Root privileges required. Re-run as root or install sudo." >&2
  exit 1
fi

exec "${script}" "$@"
